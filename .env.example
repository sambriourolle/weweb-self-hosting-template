# Copy to .env, then replace every CHANGE_ME with a different random secret.
# Generate locally; do not print or commit generated values: openssl rand -base64 36
POSTGRES_DB=weweb
POSTGRES_USER=weweb
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_APP_USER=CHANGE_ME
MINIO_APP_PASSWORD=CHANGE_ME

# Same-origin HTTP is intentionally loopback-only by default. APP_URL is built
# into the frontend; rebuild after changing it. Use HTTPS and LOCAL_HTTP=false
# for any non-loopback deployment, then test the exported authentication flow.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
APP_URL=http://127.0.0.1:8080
LOCAL_HTTP=true

# These must match the integrations configured in your own backend export.
# They do not create an account, schema, or usable sign-up flow by themselves.
AUTH_INTEGRATION=weweb-auth
PROVIDER_EMAIL_ENABLED=TRUE
PROVIDER_EMAIL_VERIFICATION_ENABLED=FALSE
PROVIDER_EMAIL_DISABLE_SIGNUP=FALSE
STORAGE_INTEGRATION=aws-s3
STORAGE_PRIVATE_BUCKET=weweb-private
STORAGE_PUBLIC_BUCKET=weweb-public
STORAGE_PRIVATE_PREFIX=private/
STORAGE_PUBLIC_PREFIX=public/
AWS_S3_REGION=us-east-1
