# Copy to .env, then replace every CHANGE_ME value with a unique secret.
# Generate locally, without printing secrets: openssl rand -base64 36
POSTGRES_DB=weweb
POSTGRES_USER=weweb
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_APP_USER=CHANGE_ME
MINIO_APP_PASSWORD=CHANGE_ME

# A same-origin HTTP deployment is deliberately loopback-only by default.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
APP_URL=http://127.0.0.1:8080
LOCAL_HTTP=true

# Match the integrations configured in your own backend export.
AUTH_INTEGRATION=weweb-auth
PROVIDER_EMAIL_ENABLED=TRUE
PROVIDER_EMAIL_VERIFICATION_ENABLED=FALSE
PROVIDER_EMAIL_DISABLE_SIGNUP=FALSE
STORAGE_INTEGRATION=aws-s3
STORAGE_PRIVATE_BUCKET=weweb-private
STORAGE_PUBLIC_BUCKET=weweb-public
STORAGE_PRIVATE_PREFIX=private/
STORAGE_PUBLIC_PREFIX=public/
AWS_S3_REGION=us-east-1
